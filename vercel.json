{
  "routes": [
    {
      "src": "/predict",
      "dest": "/api/main.py"
    },
    {
      "src": "/send-reminder",
      "dest": "/api/main.py"
    },
    {
      "src": "/cron/send-reminders",
      "dest": "/api/main.py"
    },
    {
      "src": "/docs",
      "dest": "/api/main.py"
    },
    {
      "src": "/openapi.json",
      "dest": "/api/main.py"
    },
    {
      "src": "/(.*)",
      "dest": "/frontend/$1"
    }
  ],
  "crons": [
    {
      "path": "/cron/send-reminders",
      "schedule": "0 8 * * *"
    }
  ]
}