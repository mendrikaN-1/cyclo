{
  "rewrites": [
    {
      "source": "/cron/send-reminders",
      "destination": "/api/main.py"
    },
    {
      "source": "/predict",
      "destination": "/api/main.py"
    },
    {
      "source": "/send-reminder",
      "destination": "/api/main.py"
    },
    {
      "source": "/docs",
      "destination": "/api/main.py"
    },
    {
      "source": "/openapi.json",
      "destination": "/api/main.py"
    },
    {
      "source": "/",
      "destination": "/frontend/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/frontend/$1"
    }
  ],
  "crons": [
    {
      "path": "/cron/send-reminders",
      "schedule": "0 8 * * *"
    }
  ]
}
